{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "REMOTE",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickRemoteProcess}",
            "pipeTransport": {
                "pipeProgram": "docker",
                "pipeArgs": [
                    "exec",
                    "-i",
                    "debugging_demo"
                ],
                "debuggerPath": "/vsdbg/vsdbg",
                "pipeCwd": "${workspaceFolder}",
                "quoteArgs": false
            },
            "sourceFileMap": {
                "/src": "${workspaceFolder}"
            },
            "justMyCode": true,
            // "requireExactSource": false
        },
        {
            "name": "LOCAL",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build Debugging Demo",
            "program": "${workspaceFolder}/bin/Debug/net8.0/DebuggingDemo.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:8081"
            },
            "console": "internalConsole"
        }
    ]
}
